# Salin file ini menjadi .env saat development lokal atau tambahkan di Vercel Environment Variables.

# Secret key Flask (WAJIB diisi string acak panjang di Vercel / production)
SECRET_KEY=ganti-dengan-secret-key-acak-yang-aman

# Database Cloud PostgreSQL (WAJIB untuk data permanen di Vercel, mis. Neon / Supabase / Vercel Postgres)
# Contoh: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Jika dikosongkan, aplikasi otomatis memakai SQLite lokal (instance/academic.db secara lokal, atau /tmp/academic.db di Vercel).
DATABASE_URL=

# Path database SQLite opsional (hanya dipakai jika DATABASE_URL kosong)
# DATABASE_PATH=instance/academic.db

# Konfigurasi server lokal (tidak perlu diset di Vercel)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
