# Salin file ini menjadi .env saat development lokal atau atur di dashboard hosting Anda.

# Secret key Flask (wajib diganti dengan string acak panjang di production/hosting)
SECRET_KEY=ganti-dengan-secret-key-acak-yang-aman

# Path database SQLite (di hosting seperti Render/Railway, arahkan ke Persistent Disk, mis. /var/data/academic.db)
DATABASE_PATH=instance/academic.db

# Konfigurasi server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
