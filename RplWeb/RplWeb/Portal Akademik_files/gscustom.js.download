              "infoEmpty": "Data tidak ditemukan",
              "zeroRecords": "Pencarian Tidak Ditemukan",
              "lengthMenu": "Menampilkan _MENU_ Data",
              "paginate": {
                "first":      "Pertama",
                "last":       "Terakhir",
                "next":       "Berikutnya",
