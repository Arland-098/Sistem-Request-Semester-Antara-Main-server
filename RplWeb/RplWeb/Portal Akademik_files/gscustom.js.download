      });
    });

    $(document).ready(function(){
        /* BEGIN - Handling action from dataTable*/
        // Action on submit by input
        $("form#formProcess input[type=submit]").on('click', function() {
            actionWhenSubmit("listtabelproses");
            return true;
        });

        // Action on submit by button
        $("form#formProcess button[type=submit]").on('click', function() {
            actionWhenSubmit("listtabelproses");
            return true;
        });

        // Action on submit by input
        $("form#formProcess input[type=submit]").on('click', function() {
            actionWhenSubmit("listtabelproses25");
            return true;
        });

        // Action on submit by button
        $("form#formProcess button[type=submit]").on('click', function() {
            actionWhenSubmit("listtabelproses25");
            return true;
        });

        // Action on submit by input
        $("form#formCetak input[type=submit]").on('click', function() {
            actionSelectRentang("listtabelproses");
            return true;
        });

        // Action on submit by button
        $("form#formCetak button[type=submit]").on('click', function() {
            actionSelectRentang("listtabelproses");
            return true;
        });
        /* END - Handling action from dataTable*/
    });

    function actionWhenSubmit(idDataTabel){
        // Show loading
        $("#loading").modal({
            backdrop: "static", //remove ability to close modal with click
            keyboard: false, //remove option to close with keyboard
            show: true //Display loader!
        });

        // Reset Search Key
        $("#"+idDataTabel).DataTable().search("").draw();

        // Set Display 5000
        var oTable = $("table#"+idDataTabel).dataTable();
        var oSettings = oTable.fnSettings()._iDisplayLength = -1;
            oTable.fnDraw();
        
        // Hide loading
        // setTimeout(function() {
        // $("#loading").modal("hide");
        // }, 3000);
    }

    function actionSelectRentang(idDataTabel){
        // Show loading
        $("#loading").modal({
            backdrop: "static", //remove ability to close modal with click
            keyboard: false, //remove option to close with keyboard
            show: true //Display loader!
        });

        // Reset Search Key
        $("#"+idDataTabel).DataTable().search("").draw();

        // Set Display 5000
        var oTable = $("table#"+idDataTabel).dataTable();
        var oSettings = oTable.fnSettings()._iDisplayLength = -1;
            oTable.fnDraw();

        setTimeout(function() {
            $("#loading").modal("hide");
        }, 1000);
    }

/* .end handling JqueryDatatables Custom */
